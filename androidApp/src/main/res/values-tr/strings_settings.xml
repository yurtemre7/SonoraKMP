    <string name="settings_backup_contents_title">Neler var?</string>
    <string name="settings_backup_confirm_title">Bu yedek yüklensin mi?</string>
    <string name="settings_backup_confirm_body">Yedekteki ayarlar şimdikilerin yerine geçer. Listeler birleştirilir, favoriler eklenir, dinleme istatistikleri değişir. Kitaplığında olmayan şarkılar atlanır.</string>
