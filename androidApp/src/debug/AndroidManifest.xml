<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- exported=false is unreachable from the shell uid; DUMP (held by adb shell, not by apps) guards it. -->
    <application>
        <receiver android:name="de.yurtemre.sonora.DebugLibraryProbe" android:exported="true"
            android:permission="android.permission.DUMP">
            <intent-filter><action android:name="de.yurtemre.sonora.DEBUG_SYNC" /></intent-filter>
        </receiver>
    </application>
</manifest>
